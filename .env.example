# Food Finder — environment contract (spec 01, REQ-07)
# Copy to .env.local and fill in real values. Never commit real values.

# Supabase (naming verified 2026-10-07: supabase.com/docs/guides/getting-started/api-keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ — the bundler would ship it to the browser.
SUPABASE_SECRET_KEY=

# Gemini (server-only. NEVER prefix with NEXT_PUBLIC_ — the bundler would ship it to the browser.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
