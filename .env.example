# Food Finder — environment contract (spec 01, REQ-07)
# Copy to .env.local and fill in real values. Never commit real values.

# Supabase (naming verified 2026-10-07: supabase.com/docs/guides/getting-started/api-keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ — the bundler would ship it to the browser.
SUPABASE_SECRET_KEY=

# Spoonacular API (server-only. NEVER prefix with NEXT_PUBLIC_.)
SPOONACULAR_API_KEY=
SPOONACULAR_BASE_URL=https://api.spoonacular.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
